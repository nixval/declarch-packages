// DankMaterialShell - DMS
// A beautiful, customizable, and functional shell for Linux
meta {
    title "DankMaterialShell"
    description "DankMaterialShell - A beautiful, customizable, and functional shell for Linux"
    author "AvengeMedia"
    maintained "nixval"
    url "https://github.com/AnengeMedia/DankMaterialShell"
    version "1.2.3"
    tags "shell" "dms" "quickshell" "hyprland" "wayland"
    homepage "https://github.com/AnengeMedia/DankMaterialShell"
    license "GPL-3.0"
}

// AUR Packages for DMS
pkg:aur {
    // Mandatory
    quickshell-git
    dms-shell-bin
    
    // Optional Window Manager (uncomment one)
    // niri
    // hyprland
    
    // Optional Integrations
    dgop
    dsearch-bin
    matugen
    i2c-tools
    wl-clipboard
    cliphist
    cava
    qt6-multimedia
}

// Hooks for setup
on-sync "echo 'DMS packages synced'"
