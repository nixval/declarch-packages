backend "dnf" {
    meta {
        title "DNF"
        description "Package manager for Fedora/RHEL-based distributions"
        maintained "nixval"
        tags "fedora" "rhel" "centos" "linux" "dnf" "rpm"
        url "-"
        homepage "https://dnf.readthedocs.io"
        license "-"
        platforms "linux"
        requires "dnf"
        install-guide "-"
    }

    binary "dnf"

    list "{binary} list installed --quiet | tail -n +2" {
        format "tsv"
        name_col 0
        version_col 1
    }

    install "{binary} install -y {packages}"
    remove "{binary} remove -y {packages}"
    update "{binary} check-update || true"
    upgrade "{binary} upgrade -y"
    cache_clean "{binary} clean all"

    search "{binary} search {query} --quiet" {
        format "regex"
        regex "^(.+?)\\s*:\\s*(.+)$"
        name_group 1
        desc_group 2
    }

    noconfirm "-y"
    needs_sudo "true"
}
