backend "nix" {
    meta {
        title "Nix"
        description "Functional package manager with reproducible builds"
        maintained "nixval"
        tags "nix" "nixos" "linux" "macos" "functional"
        url "-"
        homepage "https://nixos.org"
        license "-"
        platforms "linux" "macos"
        requires "nix-env"
        install-guide "-"
    }

    binary "nix-env"

    list "{binary} -q --out-path 2>/dev/null | awk '{print $1}'" {
        format "regex"
        regex "^(.+?)-([\\d.]+)$"
        name_group 1
        version_group 2
    }

    install "{binary} -iA nixpkgs.{packages}"
    remove "{binary} -e {packages}"
    update "nix-channel --update"
    upgrade "{binary} -u"

    needs_sudo "false"
}
