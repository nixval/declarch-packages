// cargo - Rust package manager
// Build system and package manager for Rust
backend "cargo" {
    meta {
        title "Cargo Package Manager"
        description "Rust's build system and package manager. Handles dependencies, building, testing, and distribution."
        version "1.0.0"
        author "declarch-community"
        tags "rust" "cargo" "package-manager" "build-system"
        homepage "https://doc.rust-lang.org/cargo/"
        license "MIT"
        created "2026-02-02"
        platforms "linux" "macos" "windows"
        requires "rust"
        examples "tokio" "serde" "clap" "axum"
    }
    
    binary "cargo" "cargo.exe"
    
    list "cargo install --list" {
        format regex
        regex {
            pattern "^(\\S+)\\s+v([\\d.]+):"
            name_group 1
            version_group 2
        }
    }
    
    install "cargo install {packages}"
    remove "cargo uninstall {packages}"
}
