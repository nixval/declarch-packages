// pnpm - Fast, disk space efficient package manager
// Alternative to npm with significant performance improvements
backend "pnpm" {
    meta {
        title "pnpm"
        description "Fast, disk space efficient package manager. Saves gigabytes of disk space compared to npm."
        version "-"
        author "-"
        maintained "nixval"
        tags "nodejs" "javascript" "pnpm" "fast" "efficient" "disk-space"
        url "-"
        homepage "https://pnpm.io"
        license "-"
        created "2026-02-08"
        platforms "linux" "macos" "windows"
        requires "nodejs"
        install-guide "-"
    }
    
    binary "pnpm"
    sudo "false"
    
    list "pnpm list -g --json" {
        format "json"
    }
    
    install "pnpm add -g {packages}"
    remove "pnpm remove -g {packages}"
}
