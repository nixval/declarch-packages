// soar - Fast, modern, open-source package manager for static binaries
// Static binary package manager with blazing speed
backend "soar" {
    meta {
        title "Soar Package Manager"
        description "Fast, modern, open-source package manager for static binaries. Installs pre-compiled static binaries instantly."
        version "1.0.0"
        author "declarch-community"
        tags "linux" "soar" "static" "binary" "fast" "modern"
        homepage "https://github.com/pkgforge/soar"
        license "MIT"
        created "2026-02-02"
        platforms "linux"
        requires "none"
        examples "eza" "bat" "fd" "ripgrep" "fzf"
    }
    
    binary "soar"
    auto_install "curl -fsSL https://install.soar.qa | sh"
    
    list "soar list" {
        format whitespace
        name_col 0
    }
    
    install "soar install -y {packages}"
    remove "soar remove --yes {packages}"
    
    noconfirm "-y"
    
    search "soar search --json {query}" {
        format json
        json {
            name_key "pkg_name"
            version_key "version"
            desc_key "description"
        }
    }
    
    strip_ansi true
}
