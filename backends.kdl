// Declarch Backend Registry
// Import all available backends or uncomment only the ones you need

// ============================================================================
// SYSTEM PACKAGE MANAGERS
// ============================================================================

// Arch Linux ecosystem - choose ONE or use 'aur' meta backend
import "backends/paru.kdl"      // Feature-packed AUR helper (recommended)
import "backends/yay.kdl"       // Alternative AUR helper
import "backends/pacman.kdl"    // Native pacman (official repos only)
import "backends/aur.kdl"       // Meta backend with auto-fallback (paru→yay→pacman)

// Debian/Ubuntu
// import "backends/nala.kdl"      // Nala frontend (fallbacks to apt)
// import "backends/apt.kdl"

// Fedora/RHEL/CentOS
// import "backends/dnf.kdl"

// Universal Linux packages
import "backends/flatpak.kdl"
import "backends/soar.kdl"
// import "backends/snap.kdl"
// import "backends/nix.kdl"

// macOS
// import "backends/brew.kdl"

// ============================================================================
// LANGUAGE-SPECIFIC PACKAGE MANAGERS
// ============================================================================

// Node.js ecosystem
import "backends/npm.kdl"
// import "backends/yarn.kdl"
// import "backends/pnpm.kdl"
// import "backends/bun.kdl"

// Python
import "backends/pip.kdl"

// Rust
import "backends/cargo.kdl"

// Ruby
// import "backends/gem.kdl"

// Go
// import "backends/go.kdl"

// ============================================================================
// NOTES
// ============================================================================
// 
// To add a backend, uncomment/import the desired file above.
//
// Fallback examples:
// - aur -> pacman
// - yay -> pacman
// - paru -> pacman
// - nala -> apt
// - yarn/pnpm/bun -> npm
